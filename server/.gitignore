# compiled output
/dist
/node_modules

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# Lingma AI skills and cache
/.lingma

# 本地个人配置文件（包含敏感信息，不要提交）
# 使用时复制 dev.yml 为 dev.local.yml，在此文件中填写真实配置
dev.local.yml

# Environment configuration files (sensitive information)
# 真实配置只留在本地，入库的是同目录下的 *.example.yml 模板
src/config/env/*.yml
!src/config/env/*.example.yml
# prod.yml 例外：config/index.ts 硬读取该文件，且 Docker 构建必须有它才能启动；
# 文件内凭据一律留空，真实值由 .env / GitHub Secrets 经环境变量注入
!src/config/env/prod.yml

# Upload folder (local test files)
/upload

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# 本项目用 pnpm，pnpm-lock.yaml 必须入库；其他包管理器的锁留在本地
package-lock.json
yarn.lock

# 后端启动时自动生成的 OpenAPI 描述文件
/openApi.json